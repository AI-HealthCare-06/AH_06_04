# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0
CHATBOT_VERSION=v1.0.0

# db
DB_HOST=localhost
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=pw1234
DB_ROOT_PASSWORD=Password123@!
DB_NAME=ai_health

# openai (학원 지급 4팀 키 — 값은 직접 붙여넣기, 절대 커밋·공유 금지)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# clova ocr (Secret Key 와 Invoke URL 둘 다 비밀값)
CLOVA_OCR_SECRET_KEY=
CLOVA_OCR_INVOKE_URL=

# FR-03 AI 가이드 — fake(키 없이 데모) | openai(OPENAI_API_KEY 필요)
GUIDE_LLM_MODE=fake
# 감수 전 안내문도 근거로 쓸지 (운영은 멘토 감수 후 false 유지)
GUIDE_ALLOW_UNREVIEWED_DOCS=true

# FR-04 챗봇 — 로그인 키는 위 SECRET_KEY 를 그대로 쓴다 (compose 가 LOGIN_SECRET_KEY 로 넘김)
# APP_ENV=prod 이면 fake LLM · 감수 전 안내문 사용이 막혀 서버가 켜지지 않는다
CHAT_APP_ENV=dev
CHAT_LLM_MODE=fake
CHAT_ALLOW_UNREVIEWED_DOCS=true
