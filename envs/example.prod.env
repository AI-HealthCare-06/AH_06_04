# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
# ENV=prod 면 아래 비밀값이 비었거나 예시 값일 때 서버가 켜지지 않는다 (docs/배포-체크리스트.md)
ENV=prod
APP_VERSION=v1.0.0
# 새로 만들기: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_DOMAIN=도메인을_넣으세요

# ai-worker
AI_WORKER_VERSION=v1.0.0
CHATBOT_VERSION=v1.0.0

# db
DB_HOST=mysql
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_NAME=ai_health
# AWS RDS 로 TLS 접속할 때: RDS 인증서 묶음(global-bundle.pem) 의 컨테이너 안 경로. 비우면 TLS 없이
#   (RDS 를 쓰면 DB_HOST=RDS 엔드포인트, DB_USER·DB_NAME 도 RDS 값으로)
#   [팀 결정 10/26] 운영(RDS)에서는 켠다 — 예: /app/certs/global-bundle.pem · RDS 파라미터 그룹 require_secure_transport=ON
DB_SSL_CA=

# redis
REDIS_PORT=6379

# openai (학원 지급 4팀 키 — 값은 직접 붙여넣기, 절대 커밋·공유 금지)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# clova ocr (Secret Key 와 Invoke URL 둘 다 비밀값)
CLOVA_OCR_SECRET_KEY=
CLOVA_OCR_INVOKE_URL=

# FR-03 AI 가이드 — fake(키 없이 데모) | openai(OPENAI_API_KEY 필요)
GUIDE_LLM_MODE=openai
# 감수 전 안내문도 근거로 쓸지 — [팀 결정 10/24] 데모데이까지 B안: true (화면 맨 위에 '감수 전 데모' 띠가 자동으로 뜬다)
#   감수가 끝나 reviewed: true 문서만으로 충분해지면 false 로 바꾼다
GUIDE_ALLOW_UNREVIEWED_DOCS=true

# FR-04 챗봇 — 로그인 키는 위 SECRET_KEY 를 그대로 쓴다 (compose 가 LOGIN_SECRET_KEY 로 넘김)
# APP_ENV: demo = prod 와 같은 검사(fake LLM 금지 등) + 감수 전 안내문 허용 (답 아래 '감수 전 자료' 표시)
#          prod = 감수(reviewed: true)된 안내문만 — 감수가 끝나면 prod + false 로 바꾼다
CHAT_APP_ENV=demo
CHAT_LLM_MODE=openai
CHAT_ALLOW_UNREVIEWED_DOCS=true

# FR-05 처방전 사진 인식 — fake(키 없이 데모) | openai(OPENAI_API_KEY 필요) | clova(위 CLOVA_OCR 키 필요)
OCR_MODE=openai
