# [앱 v1 6] 앱 시험용 로컬 서버 값 — 이 파일을 test.env 로 복사하고 값을 채운다 (test.env 는 git 에 올리지 않는다)
#   cp test.env.example test.env   →   docker compose -p gpapp --env-file test.env up -d --build
#   이 맥 안에서만 쓰는 가짜 값을 아무거나 넣는다. 진짜 .env · 운영 값은 쓰지 않는다
ENV=local
SECRET_KEY=
DB_HOST=gpapp-mysql
DB_PORT=3306
DB_USER=gp
DB_PASSWORD=
DB_NAME=ai_health
COOKIE_DOMAIN=
GUIDE_LLM_MODE=fake
OCR_MODE=fake
GUIDE_ALLOW_UNREVIEWED_DOCS=true
# 서버 코드(AH_06_04 main) 를 받아 둔 폴더 — 이 docker-compose.yml 기준 상대 경로 (비우면 ../../코드_v2_2026-10-27)
SERVER_DIR=
