# 챗봇 실습 v3 설정 — 값은 비워 두고, 진짜 값은 .env 에만 (이 파일은 이름만)
# LLM_MODE: fake(기본, 키 필요 없음·비용 0) | openai(진짜 — 팀 키, 쓸 때마다 예산 차감)
LLM_MODE=fake
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# v3: 비우면 OpenAI 본 서버(키 필요). 무료 로컬 AI 를 쓸 때만 — 예) Ollama: http://localhost:11434/v1 · 키 비워 둠
OPENAI_BASE_URL=
# 비용 손잡이 (CLAUDE.md §3)
LLM_MAX_TOKENS=400
LLM_FIRST_TOKEN_TIMEOUT_S=8
LLM_TOTAL_TIMEOUT_S=30
DAILY_MESSAGE_LIMIT=30
# v2: 로그인과 연결할 때만 — 로그인 서버 .env 의 SECRET_KEY 와 같은 값 (비우면 쿠키로 연습)
LOGIN_SECRET_KEY=
