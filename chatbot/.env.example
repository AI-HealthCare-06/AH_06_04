# 챗봇 설정 — 이 파일은 이름만. 진짜 값은 .env 에만 (.env 는 GitHub 에 올라가지 않음)
# APP_ENV: dev(로컬 개발·데모) | prod(실제 서비스 — 아래 위험한 설정이면 서버가 켜지지 않음)
APP_ENV=dev

# 로그인 필수 — 로그인 서버(팀 envs) 의 SECRET_KEY 와 같은 값. 비어 있으면 서버가 켜지지 않음
LOGIN_SECRET_KEY=

# 감수 전(reviewed: false) 안내문을 답의 근거로 쓸지. 기본 false. 지금 안내문은 모두 예시라 데모할 때만 true
ALLOW_UNREVIEWED_DOCS=false

# LLM_MODE: fake(기본, 키 필요 없음·비용 0) | openai(진짜 — 팀 키, 쓸 때마다 예산 차감)
LLM_MODE=fake
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# 비우면 OpenAI 본 서버(키 필요). OpenAI 모양 로컬 서버를 쓸 때만 — 예) Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# 비용 손잡이
LLM_MAX_TOKENS=400
LLM_FIRST_TOKEN_TIMEOUT_S=8
LLM_TOTAL_TIMEOUT_S=30
DAILY_MESSAGE_LIMIT=30

# 대화 보관 기간 (일) — 지나면 자동 삭제
CHAT_RETENTION_DAYS=30
