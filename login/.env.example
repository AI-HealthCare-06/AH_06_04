# ── 사용법 ──────────────────────────────────────────────
# 1) 터미널:  cp .env.example .env
# 2) .env 를 텍스트 편집기(또는 파이참)로 열어 = 뒤에 값을 붙여넣기 (따옴표·공백 없이)
# 3) 확인:   uv run python 키확인.py   (값은 안 보이고 채워졌는지만 나옴)
# ⚠ .env 는 GitHub·카톡·채팅에 올리지 않는다 (.gitignore 에 들어 있음)
# 키를 넣은 제공자만 진짜로 바뀌고, 비어 있으면 계속 가짜(mock)로 동작한다
# ─────────────────────────────────────────────────────
OAUTH_MODE=auto
OAUTH_REDIRECT_BASE=http://localhost:8001/api/v1/auth
FRONTEND_URL=
SECRET_KEY=

# Google — console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — developers.facebook.com > 내 앱 > 앱 설정 > 기본 설정 (앱 ID · 앱 시크릿 코드)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0

# 카카오 — developers.kakao.com > 내 애플리케이션 > 앱 키(REST API 키) · 보안(Client Secret, 켰으면)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 네이버 — developers.naver.com > Application > 내 애플리케이션 (Client ID · Client Secret)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# LINE — developers.line.biz > Console > (Provider) > LINE Login 채널 > Basic settings (Channel ID · Channel secret)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
